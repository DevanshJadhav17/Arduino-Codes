void loop() {
   if (Serial2.available() >= 4) {  // Wait for start byte + 8 data bytes
    if (Serial2.read() == 0xAA) {  // Look for header
      byte xBytes[4], yBytes[4];

      Serial2.readBytes(xBytes, 4);
      Serial2.readBytes(yBytes, 4);

      memcpy(&newPositionX, xBytes, 4);
      memcpy(&newPositionY, yBytes, 4);

      Serial.print("X: "); 
      Serial.print(newPositionX);
      Serial.print("  Y: "); 
      Serial.println(newPositionY);
    }
  }


  int32_t data[2] = { newPositionX, newPositionY }; 

  // Serial.printf("Broadcasting integers: %ld, %ld\n", newPositionX, newPositionY);

