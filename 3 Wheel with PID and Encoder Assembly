// Motor PWM pins defined in arrays
const int Lpwm[] = { 2, 3, 6, 7 };
const int Rpwm[] = { 1, 4, 5, 8 };

void setup() {
  Wire2.begin();         // Start I2C communication
  Serial.begin(115200);  // Initialize Serial communication
  Serial7.begin(115200);
  // Set motor pins as outputs using a loop
  for (int i = 0; i < 4; i++) {
    pinMode(Lpwm[i], OUTPUT);
    pinMode(Rpwm[i], OUTPUT);
  }
  while (!bno.begin()) {
    /* There was a problem detecting the BNO055 ... check your connections */
    Serial.print("Ooops, no BNO055 detected ... Check your wiring or I2C ADDR!");
    delay(100);
  }
  bno.setExtCrystalUse(true);
  new_time = millis();
}

void readencoder() {

  newPositionX = EncX.read();
  newPositionY = EncY.read();

  // Serial.print(newPositionX);
