}

void sendEncoderDataUART(){
  // Start Byte
  Serial7.write(0xAA);
  // Send 4 bytes for X position
  Serial7.write((byte *)&newPositionX, sizeof(newPositionX));
  // Send 4 bytes for Y position
  Serial7.write((byte *)&newPositionY, sizeof(newPositionY));

}

// Function to calculate wheel velocities
void equations() {
  W = R2 - L2;
  W = map(W, -255, 255, -50, 50);

  v1 = Vx + W + PD;
  v2 = -((0.5 * Vx) + (0.86602 * Vy)) + W + PD;
  v3 = (-0.5 * Vx) + (0.86602 * Vy) + W + PD;
  v4 = 0;
}

