void global_equations(){
  W = R2 - L2;
  W = map(W, -255, 255, -50, 50);
  theta = radians(bnox);
  Vgx=(cos(theta) * Vx )- (sin(theta)*Vy);
  Vgy=(sin(theta)*Vx) + (cos(theta)*Vy);

  v1 = Vgx + W + PD;
  v2 = -((0.5 * Vgx) + (0.86602 * Vgy)) + W + PD;
  v3 = ((-0.5 * Vgx) + (0.86602 * Vgy)) + W + PD;
  v4 = 0;

}

// Function to control motors using a loop
void controlMotors() {
  float speeds[] = { v1, v2, v3, v4 };  // Array of motor speeds

  for (int i = 0; i < 4; i++) {
    if (speeds[i] > 0) {
      analogWrite(Lpwm[i], constrain(speeds[i], 0, 100));
      analogWrite(Rpwm[i], 0);
    } else {
      float speed = abs(speeds[i]);
      analogWrite(Rpwm[i], constrain(speed, 0, 100));
      analogWrite(Lpwm[i], 0);
    }
  }
}

// Function to read bno values
void readbno() {
  imu::Vector<3> euler = bno.getVector(Adafruit_BNO055::VECTOR_EULER);
  bnox = euler.x();
  // Convert angles into 2 quadrants (i.e. 0-180 and 0-(-180))
  if (bnox > 180) {
    bnox = bnox - 360;
  }
  // Serial.print("bnoX: ");
  // Serial.print(bnox);
}

void pid() {
  if (W) {
    new_angle = bnox;      //deviated angle
    current_angle = bnox;  //target angle
  } else {
    new_angle = bnox;
  }

  error = new_angle - current_angle;
  if (error > 180) {
    error = error - 360;
  } else if (error < -180) {
    error = error + 360;
  }



  P = Kp * -error;


  old_time = new_time;
  new_time = millis();

  dt = new_time - old_time;
  change_error = old_error - error;
  old_error = error;

  D = kd * change_error / dt;

  integral += -error * dt;
  I = ki * integral;
  
  if(abs(error)<1){
    PD=0;
    P=0;
    D=0;
    I=0;
  }

  PD = P + D + I;
  PD = constrain(PD, -100, 100);
}

void loop() {
  // Request 4 bytes from I2C device at address 8
  Wire2.requestFrom(8, 4);

  // Read values from I2C
  if (Wire2.available() == 4) {
    Vx = Wire2.read();
    Vy = Wire2.read();
    L2 = Wire2.read();
    R2 = Wire2.read();
  } else {
    // Handle missing or incomplete data
    Vx = 0;
    Vy = 0;
    L2 = 0;
